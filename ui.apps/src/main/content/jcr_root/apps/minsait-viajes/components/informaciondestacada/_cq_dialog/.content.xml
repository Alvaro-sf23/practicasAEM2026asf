<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Informacion Destacada"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <general
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Contenido"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">

                                            
                                    <tag
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                                        fieldLabel="Tag"
                                        fieldDescription="Selecciona una etiqueta existente de AEM"
                                        name="./cq:tags"
                                        multiple="{Boolean}false"/>


                                            <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Titulo"
                                                name="./title"
                                                emptyText="Introduce el titulo"/>

                                            <description
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Descripcion"
                                                name="./description"
                                                emptyText="Introduce la descripcion"/>

                                            <buttonText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Texto del boton"
                                                name="./buttonText"
                                                emptyText="Ej. Leer mas"/>

                                            <buttonLink
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Enlace del boton"
                                                name="./buttonLink"
                                                rootPath="/content"/>

                                            <image
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Imagen"
                                                name="./image"
                                                rootPath="/content/dam"
                                                filter="hierarchy"/>
                                                
                                            <backgroundColor
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Color de fondo"
                                                fieldDescription="Selecciona el color de fondo de Información Destacada"
                                                name="./backgroundColor">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <dark
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Negro"
                                                        value="dark"/>
                                                   <light
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Blanco"
                                                        value="light"/>
                                                    <blue
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Azul"
                                                        value="blue"/>
                                                    <gray
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Gris claro"
                                                        value="gray"/>
                                                </items>
                                            </backgroundColor>


                                            

                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </general>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
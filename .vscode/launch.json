{
    "files.watcherExclude": {
        "**/target/**": true,
        "**/ui.apps/target/**": true
    },
    "search.exclude": {
        "**/target/**": true
    },
    "files.exclude": {
        "**/target/**": true
    },
    "java.project.resourceFilters": [
        "node_modules",
        "\\.git",
        "target"
    ],
    "java.import.exclusions": [
        "**/target/**",
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**"
    ],
    "java.autobuild.enabled": false
}